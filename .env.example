# --- PostgreSQL (app DB + DB của OpenFGA nằm cùng server) ---
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki_dev_password
POSTGRES_DB=premission_wiki
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
OPENFGA_DB=openfga

# --- OpenFGA ---
OPENFGA_HTTP_PORT=8080
OPENFGA_GRPC_PORT=8081
OPENFGA_PLAYGROUND_PORT=3000
OPENFGA_API_URL=http://localhost:8080
# Điền sau khi chạy authz/seed.py (tạo store + model)
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# --- LLM (Gemini) ---
GEMINI_API_KEY= your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# --- Embedding (BGE-M3 => 1024 chiều; đổi model thì đổi số chiều và tạo lại schema) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Ứng dụng ---
APP_ENV=dev
LOG_LEVEL=INFO
